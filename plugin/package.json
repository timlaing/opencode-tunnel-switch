{
  "name": "@timlaing/opencode-tunnel-switch",
  "version": "1.4.3",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --conditions=browser --import tsx --test test/*.test.ts",
    "test:coverage": "mkdir -p coverage && node --conditions=browser --import tsx --experimental-test-coverage --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts",
    "test:tui": "node --conditions=browser --import tsx test/verify-tui.ts",
    "verify:package": "bun scripts/verify-package.ts",
    "publish:package": "node scripts/publish-package.mjs",
    "verify:published": "node scripts/verify-published-package.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "main": "./index.ts",
  "description": "OpenCode v2 SSH tunnel rotation and proxy discovery plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timlaing/opencode-tunnel-switch.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/timlaing/opencode-tunnel-switch#readme",
  "files": [
    "index.ts",
    "tui.ts",
    "src/",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "@opentui/core": "^0.5.17",
    "@opentui/solid": "^0.5.17",
    "solid-js": "^1.9.12"
  },
  "overrides": {
    "seroval": "^1.6.9"
  }
}
