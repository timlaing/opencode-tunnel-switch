{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "/absolute/path/to/opencode-tunnel-switch/plugin",
      {
        "apiIp": "127.0.0.1",
        "apiPort": 8765,
        "apiScheme": "http",
        "apiToken": "paste-the-token-displayed-by-the-service",
        "configureProxy": true,
        "noProxy": [],
        "providers": [
          "opencode"
        ],
        "patterns": [
          "Error"
        ],
        "timeoutMs": 25000,
        "cooldownMs": 30000
      }
    ]
  ]
}
